{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] && node \"$CLAUDE_PROJECT_DIR/.claude/hooks/command-center.mjs\" start || true",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "TodoWrite|TaskCreate|TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] && node \"$CLAUDE_PROJECT_DIR/.claude/hooks/command-center.mjs\" sync || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
